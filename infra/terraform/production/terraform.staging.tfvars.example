project_id             = "unitern-staging-YOUR_UNIQUE_SUFFIX"
environment_name       = "staging"
region                 = "us-west1"
service_name           = "unitern-staging-web"
github_repository      = "JoshSunJ/roommate-finder"
admin_email            = "your-real-admin-address@example.com"
email_from             = "Unitern staging <accounts@your-verified-domain.example>"
r2_bucket              = "unitern-staging-listing-photos"
r2_endpoint            = "https://ACCOUNT_ID.r2.cloudflarestorage.com"
photo_public_base_url  = "https://staging-photos.your-domain.example"
road_routing_enabled   = false
max_instances          = 1
deletion_protection    = true
create_budget          = true
billing_account_id     = "000000-000000-000000"
monthly_budget_usd     = 5
enable_uptime_check    = false

# Bootstrap cloud resources and secret containers first. Enable the application
# only after the first immutable image and every required secret version exist.
deploy_application = false
container_image     = ""
