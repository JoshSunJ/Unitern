# Local PostgreSQL, started with: npm run db:up
DATABASE_URL="postgresql://roommate:roommate_dev_password@localhost:5433/roommate_finder?schema=public"
# Production deployments can use a pooled DATABASE_URL for application traffic
# and a direct connection for migration tooling. Locally they may be identical.
DIRECT_DATABASE_URL="postgresql://roommate:roommate_dev_password@localhost:5433/roommate_finder?schema=public"
# Generate a unique value before deploying, for example with: npx auth secret
AUTH_SECRET="replace-with-a-unique-secret-before-production"
# Canonical HTTPS origin used by Auth.js, for example https://unitern.example.
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
# Optional Google sign-in. Register AUTH_URL/api/auth/callback/google as an
# authorized redirect URI for a Web application in Google Auth Platform.
# These are server-only values; request only openid, email, and profile.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Server-only key from a Gemini project with billing disabled. Never NEXT_PUBLIC.
GEMINI_API_KEY=""

# Container deployments enable fail-fast startup validation. Leave this false
# for local development; the production Docker image sets it to true.
UNITERN_VALIDATE_RUNTIME_ENV="false"

# Transactional account email. Local development defaults to preview mode,
# which exposes a verification link only in the local signup UI. Production
# must use resend and the HTTPS AUTH_URL above.
EMAIL_PROVIDER="preview"
RESEND_API_KEY=""
EMAIL_FROM="Unitern <accounts@example.com>"

# Local development stores photos under public/uploads/listings. Production
# must use s3 because server filesystems are not durable across deployments.
PHOTO_STORAGE_DRIVER="local"

# S3-compatible production storage. For Cloudflare R2, use region "auto" and
# an endpoint such as https://<account-id>.r2.cloudflarestorage.com.
S3_BUCKET="roommate-finder-photos"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public custom domain or bucket URL, without a trailing slash.
PHOTO_PUBLIC_BASE_URL=""

# Public vector-map style. A basic OpenStreetMap raster style is used locally
# when this is empty. Production should use a hosted style from MapTiler or an
# equivalent provider, with provider-side domain and usage restrictions.
NEXT_PUBLIC_MAP_STYLE_URL=""

# MapTiler powers US city, address, university, employer, and POI search.
# MapTiler's free plan can use the same key for both values. The server forwards
# the Unitern request origin, so the key can remain protected by allowed HTTP
# origins such as localhost:3000 and your production hostname.
MAPTILER_API_KEY=""
NEXT_PUBLIC_MAPTILER_KEY=""

# Without a Mapbox token, a bounded FOSSGIS / OSRM public routing preview is used.
# Set ROAD_ROUTING_PROVIDER=disabled to turn off network routing (e.g. tests).
ROAD_ROUTING_PROVIDER="osrm"

# Server-only optional Mapbox token for walking, cycling, driving, and ride-share road
# geometry. Do not prefix this variable with NEXT_PUBLIC_: the browser calls
# Unitern's /api/commute/routes endpoint instead of receiving the token.
MAPBOX_ACCESS_TOKEN=""
