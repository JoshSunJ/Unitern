{
  "name": "roomate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "audit:dependencies": "tsx scripts/audit-dependencies.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:beta": "playwright test --config=playwright.beta.config.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "release:validate:cloud": "tsx scripts/validate-cloud-release.ts",
    "release:check": "npm run audit:dependencies && npm run lint && npm test && npm run test:integration && npm run test:e2e && npm run test:e2e:beta && npm run build",
    "security:prune-rate-limits": "tsx scripts/prune-rate-limits.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate:production": "tsx scripts/validate-production-database.ts",
    "deploy:validate": "tsx scripts/validate-production-environment.ts",
    "db:release": "npm run db:validate:production && npm run db:deploy",
    "email:validate:production": "tsx scripts/validate-production-email.ts",
    "photos:validate:production": "tsx scripts/validate-production-photo-storage.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2",
    "mysql2": "3.24.3",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    }
  }
}
