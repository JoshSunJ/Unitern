generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                               Int                       @id @default(autoincrement())
  name                             String
  email                            String                    @unique
  emailVerifiedAt                  DateTime?
  googleSubject                    String?                   @unique
  passwordHash                     String?
  sessionVersion                   Int                       @default(0)
  affiliationType                  String?
  affiliationName                  String?
  verificationStatus               String                    @default("unverified")
  verificationSubmittedAt          DateTime?
  affiliationVerificationMethod    String?
  affiliationVerifiedAt            DateTime?
  affiliationExpiresAt             DateTime?
  createdAt                        DateTime                  @default(now())
  listings                         Listing[]
  housingRequests                  HousingRequest[]
  ownedConversations               Conversation[]            @relation("ConversationOwner")
  seekingConversations             Conversation[]            @relation("ConversationSeeker")
  messages                         Message[]
  savedListings                    SavedListing[]
  savedHousingRequests             SavedHousingRequest[]
  reportsMade                      Report[]                  @relation("ReportReporter")
  reportsReviewed                  Report[]                  @relation("ReportReviewer")
  blocksCreated                    UserBlock[]               @relation("Blocker")
  blocksReceived                   UserBlock[]               @relation("Blocked")
  emailVerificationTokens          EmailVerificationToken[]
  passwordResetToken               PasswordResetToken?
  affiliationVerifications         AffiliationVerification[] @relation("VerificationSubject")
  reviewedAffiliationVerifications AffiliationVerification[] @relation("VerificationReviewer")
}

model Organization {
  id            Int                       @id @default(autoincrement())
  name          String
  type          String
  active        Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  domains       OrganizationDomain[]
  verifications AffiliationVerification[]

  @@unique([name, type])
  @@index([type, active])
}

model OrganizationDomain {
  id             Int          @id @default(autoincrement())
  organizationId Int
  domain         String       @unique
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AffiliationVerification {
  id                      Int       @id @default(autoincrement())
  userId                  Int
  organizationId          Int?
  reviewerId              Int?
  affiliationType         String
  claimedOrganizationName String
  affiliationEmail        String
  expectedEndDate         DateTime?
  method                  String
  status                  String
  providerReference       String?
  reviewerNote            String?
  submittedAt             DateTime  @default(now())
  verifiedAt              DateTime?
  expiresAt               DateTime?
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user         User                          @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?                 @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reviewer     User?                         @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  emailToken   AffiliationVerificationToken?

  @@index([userId, createdAt])
  @@index([status, submittedAt])
  @@index([organizationId])
  @@index([reviewerId])
}

model AffiliationVerificationToken {
  id             String   @id @default(cuid())
  verificationId Int      @unique
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  verification AffiliationVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    Int      @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Fixed-window counters shared by every application instance. Keys contain
// only SHA-256 digests, never raw email addresses or IP addresses.
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Listing {
  id                Int            @id @default(autoincrement())
  title             String
  rent              Int
  location          String
  description       String
  bedrooms          Int
  bathroomType      String
  availableFrom     String
  availableUntil    String?
  roomType          String         @default("private")
  leaseType         String         @default("fixed_term")
  furnished         Boolean        @default(false)
  utilitiesIncluded Boolean        @default(false)
  utilitiesEstimate Int?
  securityDeposit   Int?
  parkingAvailable  Boolean        @default(false)
  petsAllowed       Boolean        @default(false)
  postedBy          String
  status            String         @default("active")
  ownerId           Int
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // Coordinates are optional until an address-to-map lookup is added.
  latitude          Float?
  longitude         Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  conversations     Conversation[]
  photos            ListingPhoto[]
  savedBy           SavedListing[]

  @@index([location])
  @@index([rent])
  @@index([ownerId])
}

model ListingPhoto {
  id         Int      @id @default(autoincrement())
  listingId  Int
  url        String
  storageKey String   @unique
  altText    String
  position   Int
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

model SavedListing {
  userId    Int
  listingId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
}

model Conversation {
  id               Int      @id @default(autoincrement())
  listingId        Int?
  housingRequestId Int?
  ownerId          Int
  seekerId         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  housingRequest HousingRequest? @relation(fields: [housingRequestId], references: [id], onDelete: Cascade)
  owner          User            @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  seeker         User            @relation("ConversationSeeker", fields: [seekerId], references: [id], onDelete: Restrict)
  messages       Message[]

  @@unique([listingId, seekerId])
  @@unique([housingRequestId, seekerId])
  @@index([housingRequestId])
  @@index([ownerId, updatedAt])
  @@index([seekerId, updatedAt])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// A housing request is the seeker side of the marketplace: someone describing
// the room they need, rather than a room they have available.
model HousingRequest {
  id                Int      @id @default(autoincrement())
  ownerId           Int
  title             String
  maxRent           Int
  preferredLocation String
  description       String
  moveInDate        String
  moveOutDate       String
  bedroomsNeeded    Int      @default(1)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  savedBy       SavedHousingRequest[]

  @@index([ownerId])
  @@index([preferredLocation])
  @@index([maxRent])
}

model SavedHousingRequest {
  userId           Int
  housingRequestId Int
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  housingRequest HousingRequest @relation(fields: [housingRequestId], references: [id], onDelete: Cascade)

  @@id([userId, housingRequestId])
  @@index([userId, createdAt])
}

// Reports preserve the original complaint and the administrator's decision.
// targetType + targetId is a deliberate polymorphic reference: the service
// validates that the target exists before creating the report.
model Report {
  id            Int       @id @default(autoincrement())
  reporterId    Int
  reviewerId    Int?
  targetType    String
  targetId      Int
  reason        String
  details       String?
  status        String    @default("pending")
  moderatorNote String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
